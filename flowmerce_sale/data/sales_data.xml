<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence for Sale Orders -->
    <record id="sequence_sale_order" model="ir.sequence">
        <field name="name">Sale Order</field>
        <field name="code">flowmerce.sale.order</field>
        <field name="prefix">SO</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Weekly reminder on quotations pending for more than 7 days -->
    <record id="cron_followup_quotations" model="ir.cron">
        <field name="name">Flowmerce Sale: Stale Quotation Follow-Up</field>
        <field name="model_id" ref="model_flowmerce_sale_order"/>
        <field name="state">code</field>
        <field name="code">model.cron_auto_followup_quotations()</field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
