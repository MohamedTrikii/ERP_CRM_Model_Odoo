<odoo>
    <!-- Rapport de vente (exemple) -->
    <template id="report_saleorder_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <h2>Commande de vente : <span t-field="o.name"/></h2>
                <p>Client : <span t-field="o.partner_id.name"/></p>
                <p>Date : <span t-field="o.date_order"/></p>
                <p>Total : <span t-field="o.amount_total"/></p>
            </t>
        </t>
    </template>
</odoo>
