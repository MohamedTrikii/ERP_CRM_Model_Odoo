<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_purchase_order_tree" model="ir.ui.view">
        <field name="name">purchase.order.tree</field>
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <list string="Purchase Orders"
                  decoration-muted="state=='cancel'"
                  decoration-bf="state=='purchase'"
                  decoration-danger="delay_risk=='high'"
                  decoration-warning="delay_risk=='medium'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id" optional="show"/>
                <field name="date_order"/>
                <field name="expected_delivery_date" optional="show"/>
                <field name="amount_total" string="Total"/>
                <field name="supplier_score" string="Supplier Score" optional="show"/>
                <field name="delay_risk" widget="badge"
                       decoration-success="delay_risk=='low'"
                       decoration-warning="delay_risk=='medium'"
                       decoration-danger="delay_risk=='high'"
                       optional="show"/>
                <field name="auto_order_flag" string="Auto" optional="show"/>
                <field name="invoice_status" optional="show"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('purchase','received','invoiced')"
                       decoration-warning="state=='sent'"
                       decoration-danger="state=='cancel'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <form string="Purchase Order">
                <header>
                    <button name="action_rfq_send" string="Send RFQ" type="object"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_confirm" string="Confirm Order" type="object"
                            invisible="state not in ('draft','sent')" class="btn-primary"/>
                    <button name="action_received" string="Mark as Received" type="object"
                            invisible="state != 'purchase'" class="btn-secondary"/>
                    <button name="evaluate_supplier" string="📊 Evaluate Supplier" type="object"
                            class="btn-info"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('invoiced','cancel','received')"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,purchase,received,invoiced"/>
                </header>
                <sheet>
                    <!-- Supplier Intelligence KPI Banner -->
                    <div class="alert alert-secondary d-flex gap-4 py-2 mb-3">
                        <div class="text-center">
                            <div class="fw-bold fs-4 text-primary">
                                <field name="supplier_score" readonly="1"/>
                            </div>
                            <small>Supplier Score</small>
                        </div>
                        <div class="text-center">
                            <field name="delay_risk" widget="badge"
                                   decoration-success="delay_risk=='low'"
                                   decoration-warning="delay_risk=='medium'"
                                   decoration-danger="delay_risk=='high'"/>
                            <div><small>Delivery Risk</small></div>
                        </div>
                        <div class="text-center">
                            <field name="auto_order_flag" widget="boolean_toggle"/>
                            <div><small>Auto-Order</small></div>
                        </div>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Supplier Information">
                            <field name="partner_id" readonly="state not in ('draft','sent')"/>
                            <field name="partner_email"/>
                            <field name="partner_phone"/>
                        </group>
                        <group string="Order Details">
                            <field name="date_order" readonly="state not in ('draft','sent')"/>
                            <field name="date_approve" readonly="1"/>
                            <field name="expected_delivery_date"/>
                            <field name="actual_delivery_date"
                                   invisible="state not in ('received','invoiced')"/>
                            <field name="user_id"/>
                            <field name="team_id"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="priority" widget="priority"/>
                        </group>
                    </group>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="priority" widget="priority"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines" name="order_lines">
                            <field name="order_line"
                                   readonly="state not in ('draft','sent')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom"/>
                                    <field name="price_unit"/>
                                    <field name="discount" optional="show"/>
                                    <field name="price_subtotal" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Supplier Intelligence" name="supplier_intelligence">
                            <group>
                                <group string="Scores">
                                    <field name="supplier_score"/>
                                    <field name="delay_risk"/>
                                    <field name="auto_order_flag"/>
                                </group>
                                <group string="Other">
                                    <field name="expected_amount"/>
                                    <field name="probability"/>
                                    <field name="note"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer oe_right" colspan="2">
                        <field name="amount_untaxed"/>
                        <field name="amount_tax"/>
                        <div class="oe_subtotal_footer_separator oe_inline">
                            <label for="amount_total"/>
                        </div>
                        <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_purchase_order_search" model="ir.ui.view">
        <field name="name">purchase.order.search</field>
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <search string="Search Purchase Orders">
                <field name="name" string="Reference"/>
                <field name="partner_id" string="Supplier"/>
                <field name="user_id" string="Buyer"/>
                <filter string="My Purchases" name="my_purchases"
                        domain="[('user_id','=',uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state','=','purchase')]"/>
                <filter string="Received" name="received" domain="[('state','=','received')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancel')]"/>
                <separator/>
                <filter string="High Delivery Risk" name="high_risk"
                        domain="[('delay_risk','=','high')]"/>
                <filter string="Auto-Order" name="auto_order"
                        domain="[('auto_order_flag','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Supplier" name="group_supplier"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'state'}"/>
                    <filter string="Order Date" name="group_date"
                            context="{'group_by': 'date_order:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_purchase_order" model="ir.actions.act_window">
        <field name="name">Purchase Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">tree,form</field>
            <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_purchase_order_search"/>
        <field name="context">{'search_default_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Purchase Order!
            </p>
        </field>
    </record>

    <!-- RFQ Action -->
    <record id="action_rfq" model="ir.actions.act_window">
        <field name="name">Requests for Quotation</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_purchase_order_search"/>
        <field name="domain">[('state','in',['draft','sent'])]</field>
        <field name="context">{'search_default_draft': 1}</field>
    </record>
</odoo>
