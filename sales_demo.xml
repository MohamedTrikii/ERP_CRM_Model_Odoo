<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Partenaires de démonstration -->
        <record id="demo_partner_1" model="res.partner">
            <field name="name">Entreprise Alpha</field>
            <field name="email">contact@alpha.com</field>
            <field name="phone">+216 71 123 456</field>
            <field name="customer_rank">1</field>
            <field name="street">Avenue Habib Bourguiba</field>
            <field name="city">Tunis</field>
            <field name="country_id" ref="base.tn"/>
        </record>

        <record id="demo_partner_2" model="res.partner">
            <field name="name">Solutions Beta SARL</field>
            <field name="email">info@beta.tn</field>
            <field name="phone">+216 71 789 012</field>
            <field name="customer_rank">1</field>
            <field name="street">Rue de la Liberté</field>
            <field name="city">Sfax</field>
            <field name="country_id" ref="base.tn"/>
        </record>

        <record id="demo_partner_3" model="res.partner">
            <field name="name">Gamma Technologies</field>
            <field name="email">contact@gamma.com</field>
            <field name="phone">+216 71 345 678</field>
            <field name="customer_rank">1</field>
            <field name="street">Boulevard du 7 Novembre</field>
            <field name="city">Sousse</field>
            <field name="country_id" ref="base.tn"/>
        </record>

        <!-- Commandes de démonstration -->
        <record id="demo_sale_order_1" model="erp.sale.order">
            <field name="partner_id" ref="demo_partner_1"/>
            <field name="date_order" eval="(DateTime.now() - timedelta(days=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="state">draft</field>
            <field name="user_id" ref="base.user_admin"/>
        </record>

        <record id="demo_sale_order_2" model="erp.sale.order">
            <field name="partner_id" ref="demo_partner_2"/>
            <field name="date_order" eval="(DateTime.now() - timedelta(days=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="state">sent</field>
            <field name="user_id" ref="base.user_admin"/>
        </record>

        <record id="demo_sale_order_3" model="erp.sale.order">
            <field name="partner_id" ref="demo_partner_3"/>
            <field name="date_order" eval="(DateTime.now() - timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="state">sale</field>
            <field name="user_id" ref="base.user_admin"/>
        </record>

        <!-- Lignes de commande (nécessite des produits) -->
        <!-- Note: Ces lignes seront créées après avoir des produits dans le système -->
    </data>
</odoo>