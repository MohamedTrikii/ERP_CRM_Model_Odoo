<odoo>
    <!-- Wizard pour générer une facture depuis une commande de vente -->
    <record id="view_sale_invoice_wizard" model="ir.ui.view">
        <field name="name">sale.invoice.wizard.form</field>
        <field name="model">sale.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Créer une facture">
                <group>
                    <field name="order_id"/>
                    <field name="invoice_date"/>
                </group>
                <footer>
                    <button string="Créer la facture" type="object" name="action_create_invoice" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
