<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu -->
    <menuitem id="menu_sale_root"
              name="Flowmerce Sales"
              sequence="10"
              web_icon="erp_sales,static/description/icon.png"/>

    <!-- Dashboard -->
    <menuitem id="menu_sale_dashboard"
              name="Dashboard"
              parent="menu_sale_root"
              action="sale.action_sale_dashboard"
              sequence="5"/>

    <!-- Sous-menu Commandes -->
    <menuitem id="menu_sale_orders"
              name="Commandes"
              parent="menu_sale_root"
              sequence="10"/>

    <menuitem id="menu_sale_order_all"
              name="Toutes les commandes"
              parent="menu_sale_orders"
              action="action_sale_order"
              sequence="1"/>

    <menuitem id="menu_sale_quotations"
              name="Devis"
              parent="menu_sale_orders"
              action="action_quotations"
              sequence="2"/>

    <!-- Sous-menu Rapports -->
    <menuitem id="menu_sale_reports"
              name="Rapports"
              parent="menu_sale_root"
              sequence="50"/>

    <!-- Sous-menu Configuration -->
    <menuitem id="menu_sale_config"
              name="Configuration"
              parent="menu_sale_root"
              sequence="100"
              groups="base.group_system"/>
</odoo>