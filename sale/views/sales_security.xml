<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Groupes de sécurité -->
        <record id="group_sale_user" model="res.groups">
            <field name="name">Utilisateur : Propres commandes seulement</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sale_manager" model="res.groups">
            <field name="name">Administrateur</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="implied_ids" eval="[(4, ref('group_sale_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Règles d'accès aux enregistrements -->
        <!-- Utilisateurs : accès à leurs propres commandes -->
        <record id="sale_order_rule_user" model="ir.rule">
            <field name="name">Commandes de vente : Utilisateur voit ses propres commandes</field>
            <field name="model_id" ref="model_erp_sale_order"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_sale_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Managers : accès à toutes les commandes -->
        <record id="sale_order_rule_manager" model="ir.rule">
            <field name="name">Commandes de vente : Manager voit tout</field>
            <field name="model_id" ref="model_erp_sale_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sale_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Règles pour les lignes de commande -->
        <record id="sale_order_line_rule_user" model="ir.rule">
            <field name="name">Lignes de commande : Utilisateur</field>
            <field name="model_id" ref="model_erp_sale_order_line"/>
            <field name="domain_force">[('order_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_sale_user'))]"/>
        </record>

        <record id="sale_order_line_rule_manager" model="ir.rule">
            <field name="name">Lignes de commande : Manager</field>
            <field name="model_id" ref="model_erp_sale_order_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sale_manager'))]"/>
        </record>
    </data>
</odoo>