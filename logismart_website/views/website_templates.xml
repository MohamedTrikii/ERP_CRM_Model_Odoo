<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Catalogue Logiciels -->
    <template id="software_catalog_page" name="Catalogue Logiciels">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty bg-light">
                <section class="s_title pt64 pb64 text-center">
                    <div class="container">
                        <h1 class="display-3 fw-bold text-gradient">LogiSmart SaaS Platform</h1>
                        <p class="lead text-muted">Des logiciels professionnels pour propulser votre entreprise.</p>
                    </div>
                </section>
                <div class="container pb64">
                    <div class="row">
                        <t t-foreach="products" t-as="product">
                            <div class="col-lg-4 col-md-6 mb-4">
                                <div class="card h-100 shadow-sm border-0 saas-card">
                                    <div class="card-body text-center">
                                        <h4 class="card-title fw-bold" t-esc="product.name"/>
                                        <p class="text-muted" t-esc="product.description_sale or 'Solution logicielle avancée'"/>
                                        <h3 class="text-primary mt-3"><span t-esc="product.list_price"/> € <span class="fs-6 text-muted">/ user</span></h3>
                                    </div>
                                    <div class="card-footer bg-white border-0 text-center pb-4">
                                        <a t-attf-href="/software/#{product.id}" class="btn btn-primary rounded-pill px-4 py-2">Découvrir</a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Détail Produit -->
    <template id="software_detail_page" name="Détail Logiciel">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure bg-white">
                <section class="pt64 pb64">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-6">
                                <h1 class="display-4 fw-bold" t-esc="product.name"/>
                                <p class="lead text-muted mt-3" t-esc="product.description_sale"/>
                                <h2 class="text-primary mt-4"><span t-esc="product.list_price"/> €</h2>
                                <div class="mt-4">
                                    <a href="/shop/cart/update" class="btn btn-dark btn-lg rounded-pill px-5 me-2 shadow-sm">Acheter maintenant</a>
                                    <a href="#" class="btn btn-outline-primary btn-lg rounded-pill px-5">Essai Gratuit</a>
                                </div>
                            </div>
                            <div class="col-lg-6 text-center">
                                <img src="/logismart_website/static/src/img/dashboard_mockup.png" class="img-fluid rounded-4 shadow-lg" alt="SaaS Dashboard"/>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
