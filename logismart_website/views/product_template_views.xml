<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_saas" model="ir.ui.view">
        <field name="name">product.template.form.inherit.saas</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="inside">
                <group string="Configuration SaaS">
                    <field name="is_saas_software"/>
                    <field name="software_version" invisible="not is_saas_software"/>
                    <field name="license_duration_days" invisible="not is_saas_software"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
