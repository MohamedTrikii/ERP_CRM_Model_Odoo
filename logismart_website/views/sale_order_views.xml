<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_inherit_saas" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.saas</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_saas_licenses" type="object" class="oe_stat_button" icon="fa-key" invisible="saas_license_count == 0">
                    <field name="saas_license_count" widget="statinfo" string="Licences SaaS"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
