<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_logismart_website" model="ir.module.category">
        <field name="name">LogiSmart Website</field>
    </record>
    <record id="group_logismart_website_user" model="res.groups">
        <field name="name">User</field>
    </record>
    <record id="rule_saas_license_portal_own" model="ir.rule">
        <field name="name">SaaS licence: portal users see their own licences</field>
        <field name="model_id" ref="model_logismart_saas_license"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
