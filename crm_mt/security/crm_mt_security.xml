<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════════════════════════
         LogiSmart ERP — Security Groups & Record Rules (crm_mt)
         ══════════════════════════════════════════════════════════════════════ -->

    <!-- ── Security Category ─────────────────────────────────────────────── -->
    <record id="module_category_crm_triki" model="ir.module.category">
        <field name="name">CRM_TRIKI ERP</field>
        <field name="description">CRM_TRIKI ERP access groups</field>
        <field name="sequence">10</field>
    </record>

    <!-- ── User Groups ────────────────────────────────────────────────────── -->
    <record id="group_crm_triki_user" model="res.groups">
        <field name="name">User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_crm_triki_sales" model="res.groups">
        <field name="name">Sales</field>
        <field name="implied_ids" eval="[(4, ref('group_crm_triki_user'))]"/>
    </record>

    <record id="group_crm_triki_purchase" model="res.groups">
        <field name="name">Purchase</field>
        <field name="implied_ids" eval="[(4, ref('group_crm_triki_user'))]"/>
    </record>

    <record id="group_crm_triki_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="implied_ids" eval="[
            (4, ref('group_crm_triki_sales')),
            (4, ref('group_crm_triki_purchase')),
        ]"/>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         Record Rules
         ══════════════════════════════════════════════════════════════════════ -->

    <!-- ── Lead: Salesperson sees own leads (users only, managers see all) ── -->
    <record id="rule_lead_own_user" model="ir.rule">
        <field name="name">CRM Lead: own records (user)</field>
        <field name="model_id" ref="crm_mt.model_crm_mt_lead"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_crm_triki_sales'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Manager sees all leads -->
    <record id="rule_lead_all_manager" model="ir.rule">
        <field name="name">CRM Lead: all records (manager)</field>
        <field name="model_id" ref="crm_mt.model_crm_mt_lead"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_crm_triki_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
