    <!-- Form View -->
    <record id="crm_mt_lead_form" model="ir.ui.view">
        <field name="name">crm.mt.lead.form</field>
        <field name="model">crm.mt.lead</field>
        <field name="arch" type="xml">
            <form string="Lead/Opportunity">
                <header>
                    <button name="action_mark_won" string="Mark as Won" type="object" class="btn-success" invisible="won_status == 'won'"/>
                    <button name="action_mark_lost" string="Mark as Lost" type="object" class="btn-secondary" invisible="won_status == 'lost'"/>
                    <button name="action_create_quotation" string="Create Quotation" type="object" class="btn-primary"/>
                    <field name="won_status" invisible="1"/>
                    <field name="stage_id" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Customer Info" col="2">
                            <field name="partner_id"/>
                            <field name="user_id"/>
                            <field name="team_id"/>
                        </group>
                        <group string="Opportunity Details" col="2">
                            <field name="name"/>
                            <field name="priority" widget="priority"/>
                            <field name="date_deadline"/>
                        </group>
                        <group string="Sales Data" col="2">
                            <field name="expected_revenue"/>
                            <field name="probability"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="crm_mt_lead_tree" model="ir.ui.view">
        <field name="name">crm.mt.lead.tree</field>
        <field name="model">crm.mt.lead</field>
        <field name="arch" type="xml">
            <list string="Leads/Opportunities">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <field name="stage_id"/>
                <field name="expected_revenue"/>
                <field name="probability"/>
                <field name="priority" widget="priority"/>
                <field name="date_deadline"/>
                <field name="won_status"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="crm_mt_lead_search" model="ir.ui.view">
        <field name="name">crm.mt.lead.search</field>
        <field name="model">crm.mt.lead</field>
        <field name="arch" type="xml">
            <search string="Search Leads/Opportunities">
                <field name="name" string="Lead Name"/>
                <field name="partner_id" string="Customer"/>
                <field name="stage_id" string="Stage"/>
                <field name="user_id" string="Salesperson"/>
                <field name="date_deadline" string="Date"/>
                <filter string="My Leads" name="my_leads" domain="[('user_id','=',uid)]"/>
                <filter string="Won" name="won" domain="[('won_status','=','won')]"/>
                <filter string="Lost" name="lost" domain="[('won_status','=','lost')]"/>
                <group>
                    <filter string="Stage" name="group_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="Salesperson" name="group_salesperson" context="{'group_by': 'user_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date_deadline'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Graph View -->
    <record id="crm_mt_lead_graph" model="ir.ui.view">
        <field name="name">crm.mt.lead.graph</field>
        <field name="model">crm.mt.lead</field>
        <field name="arch" type="xml">
            <graph string="Leads Revenue by Stage" type="bar">
                <field name="expected_revenue" type="measure"/>
                <field name="stage_id" type="row"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="crm_mt_lead_pivot" model="ir.ui.view">
        <field name="name">crm.mt.lead.pivot</field>
        <field name="model">crm.mt.lead</field>
        <field name="arch" type="xml">
            <pivot string="Leads Analysis">
                <field name="expected_revenue" type="measure"/>
                <field name="probability" type="measure"/>
                <field name="stage_id" type="row"/>
                <field name="user_id" type="col"/>
            </pivot>
        </field>
    </record>
</odoo>
