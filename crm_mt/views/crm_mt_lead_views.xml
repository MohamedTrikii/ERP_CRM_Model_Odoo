<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════════════════════════
         Flowmerce ERP — CRM Lead Views (Kanban, Form, List, Search, Graph, Pivot)
         ══════════════════════════════════════════════════════════════════════ -->

    <!-- ── Kanban View ────────────────────────────────────────────────────── -->
    <record id="crm_mt_lead_kanban" model="ir.ui.view">
        <field name="name">crm.mt.lead.kanban</field>
        <field name="model">crm.mt.lead</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_crm_lead">
                <field name="priority"/>
                <field name="stage_id"/>
                <field name="user_id"/>
                <field name="expected_revenue"/>
                <field name="probability"/>
                <field name="partner_id"/>
                <field name="won_status"/>
                <field name="lead_score"/>
                <field name="segment_client"/>
                <field name="risk_level"/>
                <field name="days_since_activity"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click
                            #{record.risk_level.raw_value == 'high' ? 'border-danger' : ''}
                            #{record.risk_level.raw_value == 'medium' ? 'border-warning' : ''}">

                            <!-- Header: title + priority badges -->
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <strong class="o_kanban_record_title fs-6">
                                    <field name="name"/>
                                </strong>
                                <div class="d-flex gap-1">
                                    <span t-if="record.priority.raw_value == '2'"
                                          class="badge text-bg-danger">🔥 Urgent</span>
                                    <span t-if="record.priority.raw_value == '1'"
                                          class="badge text-bg-warning">High</span>
                                </div>
                            </div>

                            <!-- Partner -->
                            <div class="text-muted small mb-1">
                                <i class="fa fa-user me-1"/><field name="partner_id"/>
                            </div>

                            <!-- Revenue + Score row -->
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="fw-bold text-success">
                                    <field name="expected_revenue" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </span>
                                <span class="badge text-bg-primary">
                                    Score: <t t-esc="record.lead_score.value"/>
                                </span>
                            </div>

                            <!-- Probability bar -->
                            <div class="progress mt-1" style="height:6px">
                                <div class="progress-bar bg-info"
                                     t-attf-style="width: #{record.probability.value}%"/>
                            </div>
                            <div class="text-end small text-muted">
                                <t t-esc="record.probability.value"/>%
                            </div>

                            <!-- Segment + Risk badges -->
                            <div class="d-flex gap-1 mt-2 flex-wrap">
                                <span t-if="record.segment_client.raw_value == 'vip'"
                                      class="badge text-bg-warning">⭐ VIP</span>
                                <span t-if="record.segment_client.raw_value == 'loyal'"
                                      class="badge text-bg-success">Loyal</span>
                                <span t-if="record.segment_client.raw_value == 'at_risk'"
                                      class="badge text-bg-danger">At Risk</span>
                                <span t-if="record.segment_client.raw_value == 'cold'"
                                      class="badge text-bg-secondary">Cold</span>
                                <span t-if="record.segment_client.raw_value == 'new'"
                                      class="badge text-bg-info">New</span>
                                <span t-if="record.risk_level.raw_value == 'high'"
                                      class="badge text-bg-danger">⚠ High Risk</span>
                            </div>

                            <!-- Footer: status + assignee -->
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <div>
                                    <span t-if="record.won_status.raw_value == 'won'"
                                          class="badge text-bg-success">Won</span>
                                    <span t-if="record.won_status.raw_value == 'lost'"
                                          class="badge text-bg-secondary">Lost</span>
                                    <span t-if="record.won_status.raw_value == 'pending'"
                                          class="badge text-bg-light text-dark">Pending</span>
                                </div>
                                <field name="user_id" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Form View ──────────────────────────────────────────────────────── -->
    <record id="crm_mt_lead_form" model="ir.ui.view">
        <field name="name">crm.mt.lead.form</field>
        <field name="model">crm.mt.lead</field>
        <field name="arch" type="xml">
            <form string="Lead/Opportunity">
                <header>
                    <button name="action_mark_won" string="Mark as Won" type="object"
                            class="btn-success" invisible="won_status == 'won'"/>
                    <button name="action_mark_lost" string="Mark as Lost" type="object"
                            class="btn-secondary" invisible="won_status == 'lost'"/>
                    <button name="action_create_quotation" string="Create Quotation"
                            type="object" class="btn-primary"/>
                    <button name="action_recompute_ai" string="🤖 Recompute AI Score"
                            type="object" class="btn-info"/>
                    <field name="won_status" invisible="1"/>
                    <field name="stage_id" widget="statusbar"/>
                </header>
                <sheet>
                    <!-- KPI Banner -->
                    <div class="alert alert-info d-flex gap-4 py-2 mb-3">
                        <div class="text-center">
                            <div class="fw-bold fs-4 text-primary">
                                <field name="lead_score" readonly="1"/>
                            </div>
                            <small>AI Score</small>
                        </div>
                        <div class="text-center">
                            <div class="fw-bold fs-4">
                                <field name="probability" readonly="1"/>%
                            </div>
                            <small>Win Probability</small>
                        </div>
                        <div class="text-center">
                            <field name="segment_client" widget="badge"
                                   decoration-warning="segment_client == 'vip'"
                                   decoration-success="segment_client == 'loyal'"
                                   decoration-danger="segment_client == 'at_risk'"
                                   decoration-secondary="segment_client in ('cold','new')"/>
                            <div><small>Segment</small></div>
                        </div>
                        <div class="text-center">
                            <field name="risk_level" widget="badge"
                                   decoration-success="risk_level == 'low'"
                                   decoration-warning="risk_level == 'medium'"
                                   decoration-danger="risk_level == 'high'"/>
                            <div><small>Risk</small></div>
                        </div>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" placeholder="Lead Title..."/></h1>
                    </div>
                    <group>
                        <group string="Customer Info">
                            <field name="partner_id"/>
                            <field name="user_id"/>
                            <field name="team_id"/>
                        </group>
                        <group string="Pipeline">
                            <field name="priority" widget="priority"/>
                            <field name="date_deadline"/>
                            <field name="lost_reason_id" invisible="won_status != 'lost'"/>
                        </group>
                        <group string="Revenue">
                            <field name="expected_revenue"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group string="AI Insights" readonly="1">
                            <field name="last_activity_date"/>
                            <field name="days_since_activity"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── List View ──────────────────────────────────────────────────────── -->
    <record id="crm_mt_lead_tree" model="ir.ui.view">
        <field name="name">crm.mt.lead.tree</field>
        <field name="model">crm.mt.lead</field>
        <field name="arch" type="xml">
            <list string="Leads/Opportunities"
                  decoration-danger="risk_level == 'high'"
                  decoration-warning="risk_level == 'medium'"
                  decoration-success="won_status == 'won'"
                  decoration-muted="won_status == 'lost'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="stage_id"/>
                <field name="lead_score" string="Score" optional="show"/>
                <field name="segment_client" widget="badge"
                       decoration-warning="segment_client == 'vip'"
                       decoration-success="segment_client == 'loyal'"
                       decoration-danger="segment_client == 'at_risk'"/>
                <field name="risk_level" widget="badge"
                       decoration-success="risk_level == 'low'"
                       decoration-warning="risk_level == 'medium'"
                       decoration-danger="risk_level == 'high'"/>
                <field name="expected_revenue" sum="Total Revenue"/>
                <field name="probability"/>
                <field name="priority" widget="priority"/>
                <field name="date_deadline"/>
                <field name="won_status" widget="badge"
                       decoration-success="won_status == 'won'"
                       decoration-secondary="won_status == 'lost'"
                       decoration-info="won_status == 'pending'"/>
            </list>
        </field>
    </record>

    <!-- ── Search View ────────────────────────────────────────────────────── -->
    <record id="crm_mt_lead_search" model="ir.ui.view">
        <field name="name">crm.mt.lead.search</field>
        <field name="model">crm.mt.lead</field>
        <field name="arch" type="xml">
            <search string="Search Leads/Opportunities">
                <field name="name" string="Lead Name"/>
                <field name="partner_id" string="Customer"/>
                <field name="stage_id" string="Stage"/>
                <field name="user_id" string="Salesperson"/>
                <separator/>
                <filter string="My Leads" name="my_leads" domain="[('user_id','=',uid)]"/>
                <filter string="Won" name="won" domain="[('won_status','=','won')]"/>
                <filter string="Lost" name="lost" domain="[('won_status','=','lost')]"/>
                <filter string="Pending" name="pending" domain="[('won_status','=','pending')]"/>
                <separator/>
                <filter string="High Risk" name="high_risk"
                        domain="[('risk_level','=','high')]"/>
                <filter string="VIP Clients" name="vip"
                        domain="[('segment_client','=','vip')]"/>
                <filter string="At-Risk Clients" name="at_risk"
                        domain="[('segment_client','=','at_risk')]"/>
                <filter string="Inactive 30+ days" name="inactive"
                        domain="[('days_since_activity','>=',30)]"/>
                <group>
                    <filter string="Stage" name="group_stage"
                            context="{'group_by': 'stage_id'}"/>
                    <filter string="Segment" name="group_segment"
                            context="{'group_by': 'segment_client'}"/>
                    <filter string="Risk Level" name="group_risk"
                            context="{'group_by': 'risk_level'}"/>
                    <filter string="Salesperson" name="group_salesperson"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Graph View ─────────────────────────────────────────────────────── -->
    <record id="crm_mt_lead_graph" model="ir.ui.view">
        <field name="name">crm.mt.lead.graph</field>
        <field name="model">crm.mt.lead</field>
        <field name="arch" type="xml">
            <graph string="Lead Revenue by Stage" type="bar" stacked="True">
                <field name="stage_id" type="row"/>
                <field name="segment_client" type="col"/>
                <field name="expected_revenue" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ── Pivot View ─────────────────────────────────────────────────────── -->
    <record id="crm_mt_lead_pivot" model="ir.ui.view">
        <field name="name">crm.mt.lead.pivot</field>
        <field name="model">crm.mt.lead</field>
        <field name="arch" type="xml">
            <pivot string="Leads Analysis">
                <field name="stage_id" type="row"/>
                <field name="user_id" type="col"/>
                <field name="expected_revenue" type="measure"/>
                <field name="probability" type="measure"/>
                <field name="lead_score" type="measure"/>
            </pivot>
        </field>
    </record>
</odoo>

