<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actions -->
    <record id="crm_mt_action_lead" model="ir.actions.act_window">
        <field name="name">Leads/Opportunities</field>
        <field name="res_model">crm.mt.lead</field>
        <field name="view_mode">kanban,form,list,search,graph,pivot</field>
        <field name="view_id" ref="crm_mt_lead_kanban"/>
        <field name="search_view_id" ref="crm_mt_lead_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first lead</p>
        </field>
    </record>

    <record id="crm_mt_action_sale" model="ir.actions.act_window">
        <field name="name">Sales</field>
        <field name="res_model">crm.mt.sale</field>
        <field name="view_mode">kanban,form,list,search,graph,pivot</field>
        <field name="view_id" ref="crm_mt_sale_kanban"/>
        <field name="search_view_id" ref="crm_mt_sale_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first sale order</p>
        </field>
    </record>

    <record id="crm_mt_action_purchase" model="ir.actions.act_window">
        <field name="name">Purchases</field>
        <field name="res_model">crm.mt.purchase</field>
        <field name="view_mode">kanban,form,list,search,graph,pivot</field>
        <field name="view_id" ref="crm_mt_purchase_kanban"/>
        <field name="search_view_id" ref="crm_mt_purchase_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first purchase order</p>
        </field>
    </record>

    <record id="crm_mt_action_team" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">crm.mt.team</field>
        <field name="view_mode">kanban,form,list,search,graph,pivot</field>
        <field name="view_id" ref="crm_mt_team_kanban"/>
        <field name="search_view_id" ref="crm_mt_team_search"/>
    </record>

    <record id="crm_mt_action_stage" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">crm.mt.stage</field>
        <field name="view_mode">kanban,form,list,search,graph,pivot</field>
        <field name="view_id" ref="crm_mt_stage_kanban"/>
        <field name="search_view_id" ref="crm_mt_stage_search"/>
    </record>

    <record id="crm_mt_action_lost_reason" model="ir.actions.act_window">
        <field name="name">Lost Reasons</field>
        <field name="res_model">crm.mt.lost.reason</field>
        <field name="view_mode">kanban,form,list,search,graph,pivot</field>
        <field name="view_id" ref="crm_mt_lost_reason_kanban"/>
        <field name="search_view_id" ref="crm_mt_lost_reason_search"/>
    </record>

    <!-- Menus -->
    <menuitem id="crm_mt_root_menu" name="Flowmerce CRM" sequence="20"/>

    <menuitem id="crm_mt_menu_dashboard"
              name="Dashboard"
              parent="crm_mt_root_menu"
              action="action_crm_dashboard"
              sequence="5"/>

    <menuitem id="crm_mt_menu_lead"
              name="Leads/Opportunities"
              parent="crm_mt_root_menu"
              action="crm_mt_action_lead"
              sequence="10"/>
    <menuitem id="crm_mt_menu_sale"
              name="Sales"
              parent="crm_mt_root_menu"
              action="crm_mt_action_sale"
              sequence="20"/>
    <menuitem id="crm_mt_menu_purchase"
              name="Purchases"
              parent="crm_mt_root_menu"
              action="crm_mt_action_purchase"
              sequence="30"/>

    <menuitem id="crm_mt_menu_stock"
              name="Stock Overview"
              parent="crm_mt_root_menu"
              action="action_crm_mt_stock"
              sequence="40"/>

    <menuitem id="crm_mt_menu_config" name="Configuration" parent="crm_mt_root_menu" sequence="100"/>
    <menuitem id="crm_mt_menu_team"
              name="Teams"
              parent="crm_mt_menu_config"
              action="crm_mt_action_team"
              sequence="10"/>
    <menuitem id="crm_mt_menu_stage"
              name="Stages"
              parent="crm_mt_menu_config"
              action="crm_mt_action_stage"
              sequence="20"/>
    <menuitem id="crm_mt_menu_lost_reason"
              name="Lost Reasons"
              parent="crm_mt_menu_config"
              action="crm_mt_action_lost_reason"
              sequence="30"/>
</odoo>

