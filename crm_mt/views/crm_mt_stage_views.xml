<odoo>
    <record id="crm_mt_stage_form" model="ir.ui.view">
        <field name="name">crm.mt.stage.form</field>
        <field name="model">crm.mt.stage</field>
        <field name="arch" type="xml">
            <form string="Stage">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="is_won"/>
                        <field name="fold"/>
                        <field name="color"/>
                        <field name="team_ids"/>
                        <field name="requirements"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="crm_mt_stage_tree" model="ir.ui.view">
        <field name="name">crm.mt.stage.tree</field>
        <field name="model">crm.mt.stage</field>
        <field name="arch" type="xml">
            <tree string="Stages">
                <field name="sequence"/>
                <field name="name"/>
                <field name="is_won"/>
                <field name="fold"/>
                <field name="color"/>
            </tree>
        </field>
    </record>
</odoo>
