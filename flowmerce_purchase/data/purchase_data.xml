<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence for Purchase Orders -->
    <record id="sequence_purchase_order" model="ir.sequence">
        <field name="name">Purchase Order</field>
        <field name="code">flowmerce.purchase.order</field>
        <field name="prefix">PO</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Daily confirmation of purchase orders flagged for auto-order -->
    <record id="cron_auto_confirm_purchases" model="ir.cron">
        <field name="name">Flowmerce Purchase: Auto-Confirm Flagged POs</field>
        <field name="model_id" ref="model_flowmerce_purchase_order"/>
        <field name="state">code</field>
        <field name="code">model.auto_create_purchase_if_needed()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
